node_modules/
.next/
out/
dist/
.env
.env.local
.DS_Store
Thumbs.db
*.log
.vercel

# sorties de travail non versionnees
data/raw/*.html
packages/scraper/.cache/

# les PDF officiels de l'UNIL ne sont pas redistribues par ce depot,
# le site renvoie vers les URL officielles. Voir docs/SOURCES.md.
allmaster/*.pdf
allmaster/*.docx
tools_*.pyc
__pycache__/

# sources graphiques brutes, lourdes : les versions optimisees vivent dans
# apps/web/public/hero
sources-brutes/
shot-*.png

# captures d'ecran des horaires, lourdes et remplacees par data/horaires.
# La barre initiale n'est pas decorative : sans elle, le motif attrape TOUT
# dossier nomme « horaires », donc data/horaires, que l'application lit au
# build. Un clone neuf se serait deploye sans un seul horaire.
/horaires/

# Configuration locale d'outils, sans rapport avec le site. Le .mcp.json
# publiait en prime la reference d'un projet Supabase qui n'a rien a faire ici.
.mcp.json
.claude/

# Le depot est public : etudiants et enseignants le lisent. On n'y met que ce
# qui fait le site et ce qui prouve d'ou viennent les donnees. Les fichiers de
# travail, tableurs, captures et pages enregistrees, vivent dans
# sources-brutes/, qui n'est pas versionne.
*.xlsx
*.docx
